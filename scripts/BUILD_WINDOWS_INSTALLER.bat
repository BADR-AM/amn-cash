@echo off
chcp 65001 > nul
title بناء ملف التثبيت المكتبي AMN Cash (.exe Setup Wizard)
cls
echo ======================================================================
echo       AMN Cash - إنشاء معالج التثبيت الشامل للويندوز (.exe)
echo ======================================================================
echo.
echo [1/2] تجميع ملفات الواجهة والبرنامج...
cd /d "%~dp0\.."
call npm run build

echo.
echo [2/2] بناء حزمة التثبيت المستقلة (NSIS Setup Wizard)...
call npx electron-builder --win nsis

echo.
echo ======================================================================
echo تم بنجاح إنشاء ملف التثبيت في مجلد: dist-electron
echo ======================================================================
pause
